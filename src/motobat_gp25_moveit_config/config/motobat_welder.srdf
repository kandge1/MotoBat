<?xml version="1.0" encoding="UTF-8"?>
<!--
  Semantic description of Station 4b, welding (GP25 + MOTOPAC-RL2D scanner head), for MoveIt.

  Kinematics: closed-form OPW (config/kinematics.yaml) with parameters derived from the URDF
  (task 3.1). The chain ends at the scanner's focal point: a weld hold is a pose of s4b_focus
  on the terminal. The arm holds still while the scanner draws the seam (project_plan.md §4A.7).

  The disable_collisions list below is generated: scripts/regen_collision_matrix.sh
-->
<robot name="motobat_welder">

  <group name="welder_arm">
    <chain base_link="s4b_base_link" tip_link="s4b_focus"/>
  </group>

  <!-- config/initial_positions.yaml: focus on the module centre at weld height. -->
  <group_state name="home" group="welder_arm">
    <joint name="s4b_joint_1_s" value="0"/>
    <joint name="s4b_joint_2_l" value="-0.4932"/>
    <joint name="s4b_joint_3_u" value="-0.3548"/>
    <joint name="s4b_joint_4_r" value="0"/>
    <joint name="s4b_joint_5_b" value="-1.7092"/>
    <joint name="s4b_joint_6_t" value="0"/>
  </group_state>

  <!-- Generated by collisions_updater (see header). Do not hand-edit. -->
  <disable_collisions link1="conveyor" link2="s4b_base_link" reason="Adjacent"/>
  <disable_collisions link1="conveyor" link2="s4b_pedestal" reason="Adjacent"/>
  <disable_collisions link1="conveyor" link2="s4b_roof" reason="Adjacent"/>
