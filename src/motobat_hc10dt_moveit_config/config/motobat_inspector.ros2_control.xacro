<?xml version="1.0"?>
<!--
  ros2_control hardware for the Inspector's six joints.

  sim = mock     mock_components/GenericSystem: echoes commands back as state.
                 Used by demo.launch.py (RViz + MoveIt, no physics).
  sim = gazebo   gz_ros2_control/GazeboSimSystem inside Gazebo Harmonic
                 (task 2.2, motobat_bringup/launch/inspector_gazebo.launch.py).

  Only the <plugin> changes between mock, Gazebo, Isaac Sim and hardware. The
  joints, the interfaces and ros2_controllers.yaml stay the same, and so does
  MoveIt's FollowJointTrajectory contract (project_plan.md §4A.3, §6).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="motobat_inspector_ros2_control" params="name prefix initial_positions_file sim">
    <xacro:property name="initial_positions" value="${xacro.load_yaml(initial_positions_file)['initial_positions']}"/>

    <xacro:macro name="inspector_joint" params="joint">
      <joint name="${prefix}${joint}">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">${initial_positions[prefix + joint]}</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
    </xacro:macro>

    <ros2_control name="${name}" type="system">
      <hardware>
        <xacro:if value="${sim == 'mock'}">
          <plugin>mock_components/GenericSystem</plugin>
        </xacro:if>
        <xacro:if value="${sim == 'gazebo'}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
      </hardware>
      <xacro:inspector_joint joint="joint_1_s"/>
      <xacro:inspector_joint joint="joint_2_l"/>
      <xacro:inspector_joint joint="joint_3_u"/>
      <xacro:inspector_joint joint="joint_4_r"/>
      <xacro:inspector_joint joint="joint_5_b"/>
      <xacro:inspector_joint joint="joint_6_t"/>
    </ros2_control>

    <!-- In Gazebo, this plugin hosts the controller_manager. It reads the same
         controller file the mock setup's ros2_control_node reads. -->
    <xacro:if value="${sim == 'gazebo'}">
      <gazebo>
        <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
          <parameters>$(find motobat_hc10dt_moveit_config)/config/ros2_controllers.yaml</parameters>
        </plugin>
      </gazebo>
    </xacro:if>
  </xacro:macro>
</robot>
