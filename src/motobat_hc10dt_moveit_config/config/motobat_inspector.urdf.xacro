<?xml version="1.0"?>
<!--
  What MoveIt and ros2_control load: the Inspector station from
  motobat_description plus its ros2_control block.

  sim:=mock (default, demo.launch.py) or sim:=gazebo (task 2.2).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="motobat_inspector">
  <xacro:arg name="initial_positions_file" default="$(find motobat_hc10dt_moveit_config)/config/initial_positions.yaml"/>
  <xacro:arg name="sim" default="mock"/>

  <xacro:include filename="$(find motobat_description)/urdf/inspector_station.urdf.xacro"/>
  <xacro:include filename="$(find motobat_hc10dt_moveit_config)/config/motobat_inspector.ros2_control.xacro"/>

  <xacro:motobat_inspector_ros2_control name="InspectorSystem" prefix="s3_"
      initial_positions_file="$(arg initial_positions_file)" sim="$(arg sim)"/>
</robot>
