<?xml version="1.0" encoding="UTF-8"?>
<!--
  Semantic description of Station 3, the Inspector (HC10DT), for MoveIt.

  Kinematics: KDL (config/kinematics.yaml). OPW does not apply to the HC10DT:
  joint_5_b is offset 162 mm in Y, so the wrist axes do not intersect and the
  closed-form decoupling is invalid (project_plan.md §4A.2, §9.3).

  The disable_collisions list below is generated, not hand-written:
      scripts/regen_collision_matrix.sh
  Rerun it whenever link geometry changes (task 2.4 adds the flange and
  sensor bodies to s3_tool0).
-->
<robot name="motobat_inspector">

  <group name="inspector_arm">
    <chain base_link="s3_base_link" tip_link="s3_tool0"/>
  </group>

  <!-- Forearm forward, tool0 pointing straight down: tool0 sits at
       (0.500, 0.162, 0.805) m in s3_base_link. The 0.162 is the wrist offset.
       Verified by FK from the URDF. -->
  <group_state name="ready" group="inspector_arm">
    <joint name="s3_joint_1_s" value="0"/>
    <joint name="s3_joint_2_l" value="0"/>
    <joint name="s3_joint_3_u" value="1.5708"/>
    <joint name="s3_joint_4_r" value="0"/>
    <joint name="s3_joint_5_b" value="-1.5708"/>
    <joint name="s3_joint_6_t" value="0"/>
  </group_state>

  <!-- Generated by collisions_updater (see header). Do not hand-edit. -->
  <disable_collisions link1="s3_base_link" link2="s3_link_1_s" reason="Adjacent"/>
  <disable_collisions link1="s3_base_link" link2="s3_link_3_u" reason="Never"/>
  <disable_collisions link1="s3_link_1_s" link2="s3_link_2_l" reason="Adjacent"/>
  <disable_collisions link1="s3_link_1_s" link2="s3_link_3_u" reason="Never"/>
  <disable_collisions link1="s3_link_2_l" link2="s3_link_3_u" reason="Adjacent"/>
  <disable_collisions link1="s3_link_2_l" link2="s3_link_4_r" reason="Never"/>
  <disable_collisions link1="s3_link_3_u" link2="s3_link_4_r" reason="Adjacent"/>
  <disable_collisions link1="s3_link_3_u" link2="s3_link_5_b" reason="Never"/>
  <disable_collisions link1="s3_link_3_u" link2="s3_link_6_t" reason="Never"/>
  <disable_collisions link1="s3_link_4_r" link2="s3_link_5_b" reason="Adjacent"/>
  <disable_collisions link1="s3_link_4_r" link2="s3_link_6_t" reason="Never"/>
  <disable_collisions link1="s3_link_5_b" link2="s3_link_6_t" reason="Adjacent"/>
</robot>
