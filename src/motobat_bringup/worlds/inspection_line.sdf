<?xml version="1.0"?>
<!--
  The inspection end of the MotoBat line in Gazebo (task 2.6): the conveyor, the fixed
  line-scan gate (the baseline, plan §3.7.6) and the pallet with a defectgen module on it.
  The HC10DT is spawned into this world by inspector_gazebo.launch.py world:=line.

  Numbers from motobat_description/urdf/line_layout.xacro (keep them in step):
    floor z = 0, line along +X at y = line_y = 0, pallet top 0.9 m up,
    S3 (Inspector) pallet stop at x = s3_datum_x = 1.8 m.
  New here (A): the line-scan gate one station pitch (1.2 m) upstream, at x = 0.6 m.

  Pallet: model://motobat_pallet, generated by motobat_bringup/scripts/gazebo_module.py into
  data/gazebo/models (on GZ_SIM_RESOURCE_PATH via the launch file). Its origin is the S3
  stop: pallet_x = 0 parks the module under the robot, pallet_x = -1.2 centres it under the gate.

  Conveyor: 2.5's placeholder (view_reach.py CONVEYOR_*: pallet width + 2 x 40 mm, 100 mm
  deep, belt 50 mm below the pallet top's underside, A), run from x = 0.0 to 3.3 m.

  Ranger3 stand-in: gpu_lidar looking straight down, its fan across the line (world y),
  180 mm wide at the 500 mm reference above the terminal tops (sensors.yaml line_scan, A),
  +/- 50 mm of range, 1280 rays (of 2560, A) at 250 Hz (A; 1 kHz in defectgen). At the 100 mm/s
  of defectgen's fixed pass (0.1 mm x 1 kHz) that is a profile every 0.4 mm.
-->
<sdf version="1.9">
  <world name="inspection_line">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>

    <!-- belt top at 0.9 - 0.020 (pallet) - 0.050 (skids) = 0.830; 0.100 deep; 0.281 wide -->
    <model name="conveyor">
      <static>true</static>
      <pose>1.65 0 0.78 0 0 0</pose>
      <link name="link">
        <collision name="belt"><geometry><box><size>3.3 0.281 0.100</size></box></geometry></collision>
        <visual name="belt"><geometry><box><size>3.3 0.281 0.100</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
        <visual name="leg_a"><pose>-1.5 0 -0.415 0 0 0</pose><geometry><box><size>0.06 0.2 0.73</size></box></geometry>
          <material><ambient>0.25 0.55 0.3 1</ambient><diffuse>0.25 0.55 0.3 1</diffuse></material></visual>
        <visual name="leg_b"><pose>-0.5 0 -0.415 0 0 0</pose><geometry><box><size>0.06 0.2 0.73</size></box></geometry>
          <material><ambient>0.25 0.55 0.3 1</ambient><diffuse>0.25 0.55 0.3 1</diffuse></material></visual>
        <visual name="leg_c"><pose>0.6 0 -0.415 0 0 0</pose><geometry><box><size>0.06 0.2 0.73</size></box></geometry>
          <material><ambient>0.25 0.55 0.3 1</ambient><diffuse>0.25 0.55 0.3 1</diffuse></material></visual>
        <visual name="leg_d"><pose>1.6 0 -0.415 0 0 0</pose><geometry><box><size>0.06 0.2 0.73</size></box></geometry>
          <material><ambient>0.25 0.55 0.3 1</ambient><diffuse>0.25 0.55 0.3 1</diffuse></material></visual>
      </link>
    </model>

    <!-- The fixed line-scan gate: two posts and a beam over the belt, the sensor under the beam
         at 0.9 + 0.101 (terminal tops) + 0.500 = 1.501 m. -->
    <model name="line_scan_gate">
      <static>true</static>
      <pose>0.6 0 0 0 0 0</pose>
      <link name="link">
        <visual name="post_l"><pose>0 0.30 0.80 0 0 0</pose><geometry><box><size>0.06 0.06 1.60</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material></visual>
        <visual name="post_r"><pose>0 -0.30 0.80 0 0 0</pose><geometry><box><size>0.06 0.06 1.60</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material></visual>
        <visual name="beam"><pose>0 0 1.63 0 0 0</pose><geometry><box><size>0.06 0.66 0.06</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.3 0.3 0.35 1</diffuse></material></visual>
        <visual name="ranger3_body"><pose>0 0 1.555 0 0 0</pose><geometry><box><size>0.06 0.10 0.09</size></box></geometry>
          <material><ambient>0.1 0.3 0.7 1</ambient><diffuse>0.1 0.3 0.7 1</diffuse></material></visual>
        <!-- rpy 0 pi/2 0: lidar +x straight down, fan in the world y-z plane -->
        <sensor name="ranger3" type="gpu_lidar">
          <pose>0 0 1.501 0 1.5707963 0</pose>
          <gz_frame_id>ranger3</gz_frame_id>
          <topic>ranger3/scan</topic>
          <update_rate>50</update_rate>
          <always_on>true</always_on>
          <lidar>
            <scan>
              <horizontal><samples>1280</samples><min_angle>-0.17985</min_angle><max_angle>0.17985</max_angle></horizontal>
              <vertical><samples>1</samples></vertical>
            </scan>
            <range><min>0.45</min><max>0.55</max><resolution>0.00007</resolution></range>
            <noise><type>gaussian</type><mean>0</mean><stddev>0.00001</stddev></noise>
          </lidar>
        </sensor>
      </link>
    </model>

    <include>
      <uri>model://motobat_pallet</uri>
      <pose>1.8 0 0.9 0 0 0</pose>
    </include>
  </world>
</sdf>
