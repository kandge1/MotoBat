<?xml version="1.0"?>
<!--
  MotoBat line layout: where every station sits in `world`.

  The single source of truth for station poses. Both the full line
  (motobat_line.urdf.xacro) and the per-station descriptions that the MoveIt
  configs load (e.g. inspector_station.urdf.xacro) read these numbers, so a
  station planned alone sits exactly where it sits in the line, and its TF
  frames agree with every other station's.

  Layout is a straight line along +X at `pitch`, matching the process order.
-->
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Station pitch along the line. Change here, not in each mount. -->
  <xacro:property name="pitch"        value="1.2"/>
  <xacro:property name="table_height" value="0.0"/>

  <!-- World: z = 0 is the shop floor, the line runs along +X with the
       conveyor centreline at y = line_y, and the pallet top (the pallet datum
       every defectgen measurement is in) sits pallet_top_z above the floor,
       module length along +X. view_reach.py's floor is the same 0.9 m (A). -->
  <xacro:property name="line_y"       value="0.0"/>
  <xacro:property name="pallet_top_z" value="0.9"/>

  <!-- Station 3, Inspector (HC10DT): where the pallet stops for inspection,
       i.e. the pallet datum origin (module centre) in world. -->
  <xacro:property name="s3_datum_x" value="${pitch*1.5}"/>

  <!-- Base A from task 2.5 (view_bases.yaml, data/reach/base_A/reach.json):
       hung upside down from an overhead frame, 0.30 m to the -Y side of the
       module centreline, level with its centre along the line, 1.10 m above
       the pallet top (base ~2.0 m above the floor). Arm x axis toward the
       module. Planned in s3_base_link, so moving this changes no plan: change
       the numbers in view_bases.yaml and re-run view_plan.py first. -->
  <xacro:property name="s3_base_bx"  value="0.0"/>
  <xacro:property name="s3_base_d"   value="0.30"/>
  <xacro:property name="s3_base_bz"  value="1.10"/>

  <xacro:property name="s3_x"    value="${s3_datum_x + s3_base_bx}"/>
  <xacro:property name="s3_y"    value="${line_y - s3_base_d}"/>
  <xacro:property name="s3_z"    value="${pallet_top_z + s3_base_bz}"/>
  <xacro:property name="s3_roll" value="${pi}"/>
  <xacro:property name="s3_yaw"  value="${pi/2}"/>

  <!-- Bolt an arm's base_link to world at a given pose. roll = pi hangs it
       upside down (rpy is fixed-axis: roll about world X first, then yaw). -->
  <xacro:macro name="station_mount" params="prefix x y z yaw roll:=0">
    <joint name="${prefix}mount" type="fixed">
      <parent link="world"/>
      <child  link="${prefix}base_link"/>
      <origin xyz="${x} ${y} ${z}" rpy="${roll} 0 ${yaw}"/>
    </joint>
  </xacro:macro>

</robot>
