<?xml version="1.0"?>
<!--
  Station 1, cell placing, on its own: the GP7 with its cell gripper at its line pose in
  `world`, plus the equipment it can reach (conveyor, line-scan gate, its pedestal and
  magazines). This is the robot motobat_gp7_moveit_config plans for; link names and poses
  match motobat_line.urdf.xacro exactly, so a plan made here is valid in the full line.

      xacro placer_station.urdf.xacro > /tmp/placer.urdf
-->
<robot name="motobat_placer" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find motoman_gp7_support)/urdf/gp7_macro.xacro"/>
  <xacro:include filename="$(find motobat_description)/urdf/line_layout.xacro"/>
  <xacro:include filename="$(find motobat_description)/urdf/line_tools.xacro"/>
  <xacro:include filename="$(find motobat_description)/urdf/line_fixtures.xacro"/>

  <link name="world"/>

  <xacro:motoman_gp7 prefix="s1_"/>
  <xacro:floor_mount prefix="s1_" datum_x="${s1_datum_x}" d="${s1_base_d}" h="${s1_base_h}"/>
  <xacro:gp7_cell_gripper prefix="s1_"/>

  <xacro:conveyor_fixture/>
  <xacro:gate_fixture/>
  <xacro:s1_fixtures/>

</robot>
