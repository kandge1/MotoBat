<?xml version="1.0"?>
<!--
  MotoBat: battery module assembly line (task 3.0, 26 Nov 2026; module_spec.md §8, §11)

  Station  Robot             Prefix  Job
  S1       GP7               s1_     end plates and 12 cells into the pallet nest
  S2       (fixed gate)      -       Ranger3 line-scan as the pallet passes under
  S3a      HC10DT (hung)     s3a_    inspection before the busbar carrier
  S4a      GP4               s4a_    busbar carrier
  S3b      HC10DT (hung)     s3b_    inspection before the weld
  S4b      GP25 + RL2D head  s4b_    laser welds, inside an interlocked enclosure
  S3c      HC10DT (hung)     s3c_    inspection after the weld
  S5       GP4               s5_     CMC and cover

  Every arm comes from the Yaskawa xacro macros with its own prefix, so all seven share one
  TF tree. Poses, pedestals, magazines and the enclosure are in line_layout.xacro (numbers
  from scripts/layout_check.py and line_envelope.py); the static equipment is in
  line_fixtures.xacro, the end effectors in line_tools.xacro.

  Was (until 26 Nov): GP4 stacker, GP4 welder, HC10DT, GP7 sealer on a 1.2 m pitch, from
  before the scope moved to a module line.
-->
<robot name="motobat_line" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:include filename="$(find motoman_gp4_support)/urdf/gp4_macro.xacro"/>
  <xacro:include filename="$(find motoman_gp7_support)/urdf/gp7_macro.xacro"/>
  <xacro:include filename="$(find motoman_gp25_support)/urdf/gp25_macro.xacro"/>
  <xacro:include filename="$(find motobat_description)/urdf/line_layout.xacro"/>
  <xacro:include filename="$(find motobat_description)/urdf/inspector_station.xacro"/>
  <xacro:include filename="$(find motobat_description)/urdf/line_tools.xacro"/>
  <xacro:include filename="$(find motobat_description)/urdf/line_fixtures.xacro"/>

  <link name="world"/>

  <!-- S1: GP7 places end plates and cells -->
  <xacro:motoman_gp7 prefix="s1_"/>
  <xacro:floor_mount prefix="s1_" datum_x="${s1_datum_x}" d="${s1_base_d}" h="${s1_base_h}"/>
  <xacro:gp7_cell_gripper prefix="s1_"/>

  <!-- S3a, S3b, S3c: the inspection cells, identical relative to their pallet stops -->
  <xacro:motobat_inspector_station prefix="s3a_" datum_x="${s3a_datum_x}"/>
  <xacro:motobat_inspector_station prefix="s3b_" datum_x="${s3b_datum_x}"/>
  <xacro:motobat_inspector_station prefix="s3c_" datum_x="${s3c_datum_x}"/>

  <!-- S4a: GP4 places the busbar carrier -->
  <xacro:motoman_gp4 prefix="s4a_"/>
  <xacro:floor_mount prefix="s4a_" datum_x="${s4a_datum_x}" d="${s4a_base_d}" h="${s4a_base_h}"/>
  <xacro:gp4_vacuum_gripper prefix="s4a_"/>

  <!-- S4b: GP25 with the MOTOPAC-RL2D scanner head, in the laser enclosure -->
  <xacro:motoman_gp25 prefix="s4b_"/>
  <xacro:floor_mount prefix="s4b_" datum_x="${s4b_datum_x}" d="${s4b_base_d}" h="${s4b_base_h}"/>
  <xacro:gp25_scanner_head prefix="s4b_"/>

  <!-- S5: GP4 places the CMC and the cover -->
  <xacro:motoman_gp4 prefix="s5_"/>
  <xacro:floor_mount prefix="s5_" datum_x="${s5_datum_x}" d="${s5_base_d}" h="${s5_base_h}"/>
  <xacro:gp4_vacuum_gripper prefix="s5_"/>

  <xacro:line_fixtures/>

</robot>
