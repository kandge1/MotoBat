<?xml version="1.0" encoding="UTF-8"?>
<!--
  Semantic description of Station 1, cell placing (GP7), for MoveIt.

  Kinematics: closed-form OPW (config/kinematics.yaml, motobat_opw_kinematics_plugin). The
  GP7 has an ortho-parallel basis and a spherical wrist; its parameters are derived from
  the URDF (task 3.1). The chain ends at the gripper's TCP, so poses are planned for the
  point that touches the cell.

  The disable_collisions list below is generated, not hand-written:
      scripts/regen_collision_matrix.sh
  Rerun it whenever link or fixture geometry changes.
-->
<robot name="motobat_placer">

  <group name="placer_arm">
    <chain base_link="s1_base_link" tip_link="s1_tcp"/>
  </group>

  <!-- config/initial_positions.yaml: 100 mm above the cell magazine's pick, gripper down. -->
  <group_state name="home" group="placer_arm">
    <joint name="s1_joint_1_s" value="1.8925"/>
    <joint name="s1_joint_2_l" value="0.009"/>
    <joint name="s1_joint_3_u" value="0.1467"/>
    <joint name="s1_joint_4_r" value="0"/>
    <joint name="s1_joint_5_b" value="-1.7085"/>
    <joint name="s1_joint_6_t" value="-0.3218"/>
  </group_state>

  <!-- Generated by collisions_updater (see header). Do not hand-edit. -->
  <disable_collisions link1="conveyor" link2="gate_beam" reason="Adjacent"/>
  <disable_collisions link1="conveyor" link2="gate_post_l" reason="Adjacent"/>
  <disable_collisions link1="conveyor" link2="gate_post_r" reason="Adjacent"/>
