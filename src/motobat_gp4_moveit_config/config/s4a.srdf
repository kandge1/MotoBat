<?xml version="1.0" encoding="UTF-8"?>
<!--
  Semantic description of S4A, the GP4 that places the busbar carrier, for MoveIt.

  Kinematics: closed-form OPW (config/kinematics.yaml, motobat_opw_kinematics_plugin) with the
  vendor's own GP4 parameters (motoman_gp4_support/config/opw_parameters_gp4.yaml, reproduced
  by derive_opw.py gp4). The chain ends at the vacuum gripper's TCP (100 mm past tool0).

  The disable_collisions list below is generated: scripts/regen_collision_matrix.sh
-->
<robot name="motobat_gp4_station">

  <group name="gp4_arm">
    <chain base_link="s4a_base_link" tip_link="s4a_tcp"/>
  </group>

  <!-- config/s4a_initial_positions.yaml: 100 mm above the carrier magazine, gripper down. -->
  <group_state name="home" group="gp4_arm">
    <joint name="s4a_joint_1_s" value="1.7088"/>
    <joint name="s4a_joint_2_l" value="0.2875"/>
    <joint name="s4a_joint_3_u" value="0.3037"/>
    <joint name="s4a_joint_4_r" value="0.0"/>
    <joint name="s4a_joint_5_b" value="-1.5869"/>
    <joint name="s4a_joint_6_t" value="-0.138"/>
  </group_state>

  <!-- Generated by collisions_updater (see header). Do not hand-edit. -->
  <disable_collisions link1="conveyor" link2="s4a_base_link" reason="Adjacent"/>
  <disable_collisions link1="conveyor" link2="s4a_mag_carrier" reason="Adjacent"/>
  <disable_collisions link1="conveyor" link2="s4a_pedestal" reason="Adjacent"/>
  <disable_collisions link1="s4a_base_link" link2="s4a_link_1_s" reason="Adjacent"/>
  <disable_collisions link1="s4a_base_link" link2="s4a_link_2_l" reason="Never"/>
  <disable_collisions link1="s4a_base_link" link2="s4a_mag_carrier" reason="Adjacent"/>
  <disable_collisions link1="s4a_base_link" link2="s4a_pedestal" reason="Adjacent"/>
  <disable_collisions link1="s4a_gripper" link2="s4a_link_3_u" reason="Never"/>
  <disable_collisions link1="s4a_gripper" link2="s4a_link_5_b" reason="Never"/>
  <disable_collisions link1="s4a_gripper" link2="s4a_link_6_t" reason="Adjacent"/>
  <disable_collisions link1="s4a_link_1_s" link2="s4a_link_2_l" reason="Adjacent"/>
  <disable_collisions link1="s4a_link_1_s" link2="s4a_link_3_u" reason="Never"/>
  <disable_collisions link1="s4a_link_2_l" link2="s4a_link_3_u" reason="Adjacent"/>
  <disable_collisions link1="s4a_link_3_u" link2="s4a_link_4_r" reason="Adjacent"/>
  <disable_collisions link1="s4a_link_3_u" link2="s4a_link_5_b" reason="Never"/>
  <disable_collisions link1="s4a_link_3_u" link2="s4a_link_6_t" reason="Never"/>
  <disable_collisions link1="s4a_link_4_r" link2="s4a_link_5_b" reason="Adjacent"/>
  <disable_collisions link1="s4a_link_5_b" link2="s4a_link_6_t" reason="Adjacent"/>
  <disable_collisions link1="s4a_mag_carrier" link2="s4a_pedestal" reason="Adjacent"/>
</robot>
